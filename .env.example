# Copy this file to .env and fill in your actual values

# Supabase Configuration (Frontend)
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-anon-key

# ML Service Configuration (Production)
# Set this in Supabase Edge Functions → Secrets
ML_API_URL=https://your-ml-service.onrender.com

# ML Service Configuration (Local Development)
# This is already set as default in ml-service/app.py
MODEL_PATH=best_inceptionv3_finetuned_S_93.h5
